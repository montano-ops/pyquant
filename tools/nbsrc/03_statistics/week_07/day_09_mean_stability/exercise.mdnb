from qrc.data import get_prices
from qrc.synth import synthetic_prices

if DATA_SOURCE == "real":
    px = get_prices("SPY", start="1993-01-01")
else:
    px = synthetic_prices(n_days=8000, n_assets=1, seed=38, mu=0.0003)
    px.columns = ["SPY"]
r = px["SPY"].pct_change().dropna()
