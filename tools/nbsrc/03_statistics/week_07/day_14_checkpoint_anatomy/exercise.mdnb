if DATA_SOURCE == "real":
    px = get_prices(ASSET, start="2005-01-01")
else:
    px = synthetic_prices(n_days=4000, n_assets=1, seed=42)
    px.columns = [ASSET]
r = px[ASSET].pct_change().dropna()
