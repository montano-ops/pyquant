## Setup

```python
import os, sys, pathlib
root = pathlib.Path.cwd()
for _ in range(6):
    if (root / "qrc").is_dir():
        break
    root = root.parent
if str(root) not in sys.path:
    sys.path.insert(0, str(root))

import numpy as np
import pandas as pd
from scipy import stats
DATA_SOURCE = os.environ.get("QRC_DATA", "real")
from qrc.data import get_prices
from qrc.synth import synthetic_prices
from qrc.universe import load_universe

if DATA_SOURCE == "real":
    px = get_prices(load_universe("research50"), start="2010-01-01")
else:   # 50-asset null world: no signal exists by construction
    px = synthetic_prices(n_days=2520, n_assets=50, seed=101, drift_spread=0.0)
```

